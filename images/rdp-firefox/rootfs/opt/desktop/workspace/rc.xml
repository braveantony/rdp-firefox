<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <keyboard>
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
  </keyboard>
  <applications>
    <!-- Tool windows fill the screen above the toolbar; the home screen
         (type desktop) and the toolbar (type dock) place themselves -->
    <application class="*" type="normal">
      <maximized>true</maximized>
      <decor>no</decor>
    </application>
  </applications>
</openbox_config>
